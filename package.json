{
  "name": "krobi",
  "private": true,
  "version": "0.1.0-rc.16",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Flipspin — a Tauri desktop music manager with a FastAPI service and React frontend",
  "author": {
    "name": "nckperez",
    "email": "22043153+nckperez@users.noreply.github.com",
    "url": "https://github.com/nckperez"
  },
  "scripts": {
    "dev": "vite --config renderer/vite.config.js",
    "build": "vite build --config renderer/vite.config.js",
    "lint": "eslint renderer --config renderer/eslint.config.js",
    "preview": "vite preview --config renderer/vite.config.js",
    "tauri": "tauri",
    "start": "tauri dev",
    "build:frontend": "vite build --config renderer/vite.config.js",
    "build:backend": "node scripts/build-backend.cjs",
    "dist:win": "npm run build:backend && tauri build --bundles nsis",
    "dist:mac": "npm run build:backend && tauri build --bundles dmg",
    "dist:linux": "npm run build:backend && tauri build --bundles appimage,deb",
    "dist": "npm run build:backend && tauri build",
    "typecheck": "tsc -p renderer/tsconfig.json",
    "test": "vitest run --config renderer/vitest.config.ts",
    "test:watch": "vitest --config renderer/vitest.config.ts",
    "api:generate": "node scripts/generate-api.mjs",
    "i18n:extract": "i18next-cli extract",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "build:helper": "node scripts/build-helper.cjs",
    "build:lyrics-worker": "npm run build:helper",
    "build:desktop": "npm run build:uv && npm run build:helper && npm run build:frontend",
    "build:uv": "node scripts/bundle-uv.cjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "3.14.23",
    "@tauri-apps/api": "^2.12.4",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "i18next": "^26.4.2",
    "lucide-react": "^0.513.0",
    "mpg123-decoder": "^1.0.3",
    "ogg-opus-decoder": "^1.7.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.7",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "i18next-cli": "^1.73.2",
    "jsdom": "^30.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}

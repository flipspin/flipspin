#!/bin/sh
# Manage only the installer's Compose project. No dotenv is executed as code.
set -eu
# Resolve only a plain stable release tag; no jq/Python dependency on the host.
resolve_release() {
    release_response=$(curl -fsSL --connect-timeout 3 --max-time 8 \
            -H 'Accept: application/vnd.github+json' \
            -A 'Flipspin/0.1.0-rc.15 ( https://github.com/flipspin/flipspin )' \
            https://api.github.com/repos/flipspin/flipspin/releases/latest 2>/dev/null) || release_response=''
    release_tag=$(printf '%s\n' "$release_response" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
    ) || release_tag=''
    case "$release_tag" in *'
'*) release_tag='' ;; esac
    if printf '%s\n' "$release_tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
        printf '%s\n' "${release_tag#v}"
    else
        printf '%s\n' 'No se pudo consultar la versión publicada; se usará :latest.' >&2
        printf '%s\n' latest
    fi
}

fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }
# The original registry coordinates use the retained installer name.
canonical_image() {
    legacy_name=krobi
    case "$1" in
        "ghcr.io/$legacy_name-app/$legacy_name-server") printf '%s\n' ghcr.io/flipspin/flipspin-server ;;
        *) printf '%s\n' "$1" ;;
    esac
}
compose() (
    # Saved configuration wins over unrelated variables in the caller's shell.
    unset KROBI_IMAGE KROBI_TAG KROBI_IMAGE_TAG KROBI_MUSIC_DIR KROBI_DATA_DIR KROBI_PORT PUID PGID
    docker compose --project-name krobi --project-directory /opt/krobi -f /opt/krobi/compose.yml "$@"
)
service() {
    # New installations use flipspin; keep the saved Compose file of older servers usable.
    if compose config --services </dev/null | grep -qx flipspin; then printf '%s\n' flipspin;
    else printf '%s\n' krobi; fi
}
get_env() { sed -n "s/^$1='\(.*\)'$/\1/p" /opt/krobi/.env; }
log() { printf '%s\n' "$*"; printf '%s\n' "$*" >>/opt/krobi/install.log; }
status_json() { curl --noproxy '*' -fsS --max-time 5 "http://127.0.0.1:$port/api/status" 2>/dev/null; }
version() { sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'; }
wait_ready() {
    deadline=$(($(date +%s) + 120))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        remaining=$((deadline - $(date +%s)))
        [ "$remaining" -gt 0 ] || break
        request_timeout=5
        if [ "$remaining" -lt 5 ]; then request_timeout=$remaining; fi
        status=$(curl --noproxy '*' -fsS --max-time "$request_timeout" "http://127.0.0.1:$port/api/status" 2>/dev/null || true)
        if printf '%s' "$status" | grep -Eq '"app"[[:space:]]*:[[:space:]]*"krobi"'; then return; fi
        remaining=$((deadline - $(date +%s)))
        [ "$remaining" -gt 0 ] || break
        if [ "$remaining" -lt 2 ]; then sleep "$remaining"; else sleep 2; fi
    done
    fail 'Flipspin no respondió a /api/status en 120 s. Consulta: sudo docker compose -p krobi -f /opt/krobi/compose.yml logs --tail=100 krobi (o krobi logs).'
}
confirm() {
    ( : </dev/tty >/dev/tty ) 2>/dev/null || fail 'La desinstalación necesita una terminal para confirmar.'
    printf '%s Escribe yes o sí: ' "$1" >/dev/tty
    read -r answer </dev/tty || fail 'No se pudo leer la respuesta.'
    case "$answer" in yes|YES|sí|si|SI) ;; *) fail 'Cancelado.' ;; esac
}
# Purge is deliberately narrower than install: never recursively remove a
# system directory, a symlink, or a parent of the other mount/install directory.
purge_path() {
    [ -d "$1" ] && [ ! -L "$1" ] || fail "No se puede purgar esta ruta: $1"
    canonical=$(realpath "$1")
    [ "$canonical" = "$1" ] || fail "La ruta cambió desde la instalación: $1"
    case "$canonical" in
        /etc/*|/usr/*|/bin/*|/sbin/*|/lib/*|/lib64/*|/boot/*|/dev/*|/proc/*|/run/*|/sys/*|/var/lib|/var/log|/var/cache|/var/tmp|/opt/krobi|/opt/krobi/*)
            fail "Purga automática rechazada para $1; elimina esa carpeta manualmente." ;;
        /home/*/*|/Users/*/*) ;;
        /home/*|/Users/*) fail "No se puede purgar un directorio de usuario: $1" ;;
        /*/*) ;;
        *) fail "Purga automática rechazada para $1; elige una subcarpeta dedicada." ;;
    esac
    for protected in /opt/krobi "$music" "$data"; do
        [ "$protected" = "$1" ] && continue
        case "$protected/" in "$canonical/"*) fail "La ruta contiene otra carpeta protegida: $1" ;; esac
    done
}


command=${1:-status}
case "$command" in update|setup-link|status|logs|stop|start|uninstall|reset-password) ;; --help) printf 'Uso: krobi update|setup-link|status|logs|stop|start|uninstall [--purge]|reset-password <usuario> [--password-stdin]\n'; exit 0 ;; *) fail "Comando desconocido: $command" ;; esac
if [ "$command" = reset-password ]; then
    [ "$#" = 2 ] || { [ "$#" = 3 ] && [ "$3" = --password-stdin ]; } || fail 'Uso: krobi reset-password <usuario> [--password-stdin]'
elif [ "$#" -gt 1 ]; then
    [ "$command" = uninstall ] && [ "$#" = 2 ] && [ "$2" = --purge ] || fail 'Solo uninstall acepta --purge.'
fi
if [ "$(id -u)" != 0 ]; then exec sudo "$0" "$@"; fi
[ -f /opt/krobi/compose.yml ] && [ -f /opt/krobi/.env ] || fail 'No hay una instalación en /opt/krobi.'
grep -q '^# Managed by krobi installer$' /opt/krobi/.env || fail 'La configuración no pertenece al instalador.'
port=$(get_env KROBI_PORT)
case "$command" in
    setup-link)
        status=$(status_json) || fail 'Flipspin is not responding; check krobi logs.'
        token=
        if printf '%s' "$status" | grep -Eq '"isInit"[[:space:]]*:[[:space:]]*false'; then
            data=$(get_env KROBI_DATA_DIR)
            token=$(cat "$data/Krobi/setup-token") || fail 'Could not read the setup code; check krobi logs.'
            case "$token" in ''|*[!a-zA-Z0-9_-]*) fail 'The setup code has an unexpected format.' ;; esac
            [ "${#token}" -ge 20 ] && [ "${#token}" -le 128 ] || fail 'The setup code has an unexpected format.'
        else
            printf '%s' "$status" | grep -Eq '"isInit"[[:space:]]*:[[:space:]]*true' || fail 'Could not determine whether this nest is set up.'
        fi
        # Same primary-route/private-address preference as the installer.
        primary=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([^ ]*\).*/\1/p' || true)
        lan_ip=$({ printf '%s\n' "$primary"; ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}'; hostname -I 2>/dev/null | tr ' ' '\n'; } | awk -F. '
            NF == 4 && ($1 == 10 || ($1 == 172 && $2 >= 16 && $2 <= 31) || ($1 == 192 && $2 == 168)) {print; exit}')
        if [ -z "$lan_ip" ]; then
            lan_ip=$(hostname -I | awk '{print $1}')
            printf 'No private IPv4 address was found. Check the address before connecting from the app.\n' >&2
        fi
        [ -n "$lan_ip" ] || fail 'No network address was found. Check ip -4 addr and use the configured port.'
        running_version=$(printf '%s' "$status" | version)
        link=
        if [ -n "$token" ]; then link="krobi://$lan_ip:$port/setup#$token"; fi
        print_ending "${running_version:-unknown}" "http://$lan_ip:$port" "$link" "$token"
        ;;
    reset-password)
        shift
        if [ "${2:-}" = --password-stdin ]; then
            compose exec -T --user krobi "$(service)" python -m app reset-password "$@"
        else compose exec --user krobi "$(service)" python -m app reset-password "$@"; fi
        ;;
    update)
        old=$(status_json | version || true)
        old_id=$(compose images -q "$(service)" 2>/dev/null || true)
        image=$(canonical_image "$(get_env KROBI_IMAGE)")
        image=${image:-ghcr.io/flipspin/flipspin-server}
        saved_tag=$(get_env KROBI_TAG)
        case "$saved_tag" in
            ''|latest) image_tag=$(resolve_release); saved_tag=latest ;;
            *) image_tag=$saved_tag ;;
        esac
        # Migrate the installer's original Compose file while preserving the
        # container's follow-mode marker. Persist the image version for start.
        # Keep Compose variable expressions literal in the saved YAML.
        # shellcheck disable=SC2016
        sed 's/}:${KROBI_TAG:-latest}/}:${KROBI_IMAGE_TAG:-${KROBI_TAG:-latest}}/' /opt/krobi/compose.yml > /opt/krobi/compose.yml.tmp
        mv /opt/krobi/compose.yml.tmp /opt/krobi/compose.yml
        umask 077
        sed '/^KROBI_IMAGE=/d; /^KROBI_IMAGE_TAG=/d; /^KROBI_TAG=/d' /opt/krobi/.env > /opt/krobi/.env.tmp
        printf "KROBI_IMAGE='%s'\nKROBI_TAG='%s'\nKROBI_IMAGE_TAG='%s'\n" "$image" "$saved_tag" "$image_tag" >> /opt/krobi/.env.tmp
        mv /opt/krobi/.env.tmp /opt/krobi/.env
        log 'Descargando la imagen de Flipspin…'
        if ! compose pull >>/opt/krobi/install.log 2>&1; then
            image=$(get_env KROBI_IMAGE):$image_tag
            docker image inspect "$image" >/dev/null 2>&1 || fail 'No se pudo descargar la imagen. Consulta /opt/krobi/install.log y vuelve a ejecutar krobi update.'
            log 'No se pudo descargar la imagen; se usará la imagen local disponible.'
        fi
        compose up -d --remove-orphans --pull never >>/opt/krobi/install.log 2>&1 || fail 'No se pudo iniciar Flipspin. Consulta /opt/krobi/install.log y krobi logs.'
        wait_ready
        new=$(printf '%s' "$status" | version)
        new_id=$(compose images -q "$(service)")
        if [ -n "$old" ] && [ "$old_id" = "$new_id" ]; then
            log "Flipspin $new: ya al día ($old → $new)."
        else log "Flipspin: ${old:-sin versión anterior} → $new."; fi
        ;;
    status)
        compose ps
        status_json || fail 'Flipspin no responde; consulta krobi logs.'
        printf '\n'
        ;;
    logs) compose logs --follow --tail=100 "$(service)" ;;
    stop) compose stop ;;
    start) compose up -d --remove-orphans --pull never; wait_ready; printf 'Flipspin está listo.\n' ;;
    uninstall)
        music=$(get_env KROBI_MUSIC_DIR) data=$(get_env KROBI_DATA_DIR)
        if [ "${2:-}" = --purge ]; then
            confirm "¿Desinstalar Flipspin con --purge? Se borrarán los datos ($data); solo se retirará la carpeta de música ($music) si Flipspin la creó y está completamente vacía."
        else confirm '¿Desinstalar Flipspin? Se conservarán la música y los datos.'; fi
        if [ "${2:-}" = --purge ]; then
            purge_path "$data"
            remove_music=false
            if [ "$(get_env KROBI_MUSIC_CREATED)" = 1 ]; then
                purge_path "$music"
                # Be more conservative than detecting audio extensions: retain
                # every file, including hidden files and unknown audio formats.
                if [ -z "$(find "$music" -mindepth 1 -print -quit)" ]; then remove_music=true; fi
            fi
            if [ "$remove_music" = true ]; then
                confirm "¿ELIMINAR DEFINITIVAMENTE los datos ($data) y retirar la carpeta vacía creada por Flipspin ($music)?"
            else
                confirm "¿ELIMINAR DEFINITIVAMENTE los datos ($data)? Se conserva tu música en $music."
            fi
        fi
        compose down
        if [ "${2:-}" = --purge ]; then
            purge_path "$data"
            rm -rf -- "$data"
            printf 'Datos eliminados en %s.\n' "$data"
            # rmdir also protects files added after confirmation or while the
            # service was stopping. Never recursively delete the music folder.
            if [ "$remove_music" = true ] && rmdir -- "$music" 2>/dev/null; then
                printf 'Carpeta vacía creada por Flipspin eliminada en %s.\n' "$music"
            else printf 'Se conserva tu música en %s\n' "$music"; fi
        else printf 'Música y datos conservados en %s y %s.\n' "$music" "$data"; fi
        rm -f /opt/krobi/compose.yml /opt/krobi/.env /usr/local/bin/krobi /usr/local/bin/flipspin
        printf 'Flipspin desinstalado. Registro conservado en /opt/krobi/install.log.\n'
        ;;
esac

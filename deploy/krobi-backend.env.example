# EnvironmentFile for krobi-backend.service
#
#   install -d -m 0750 -o root -g krobi /etc/krobi
#   install -m 0640 -o root -g krobi deploy/krobi-backend.env.example /etc/krobi/backend.env
#
# systemd parses this itself -- it is NOT a shell script:
#   * no `export`
#   * no command substitution, no $VAR expansion between lines
#   * quotes are stripped; only quote a value that contains spaces
#   * a stray trailing space becomes part of the value
#
# Anything set here overrides the built-in defaults in app/config.py.
# The app ALSO reads $HOME/Krobi/.env (i.e. /var/lib/krobi/Krobi/.env) at
# startup, but only for keys not already in the environment -- so this file
# always wins. That other file is where the app itself persists Spotify
# credentials and yt-dlp cookie settings saved from the UI; leave it alone.

# --- paths ------------------------------------------------------------------
# These must sit under the service user's HOME (/var/lib/krobi), because
# app/domains/system/routes.py::set_basedir() rejects any music dir outside Path.home()
# and the .env round-trip depends on KROBI_CREDENTIALS_DIR's parent being
# $HOME/Krobi.
KROBI_MUSIC_DIR=/var/lib/krobi/Krobi/Music
KROBI_PLAYLIST_DIR=/var/lib/krobi/Krobi/playlists
KROBI_TEMP_DIR=/var/lib/krobi/Krobi/temp
KROBI_LOG_DIR=/var/lib/krobi/Krobi/logs
KROBI_CREDENTIALS_DIR=/var/lib/krobi/Krobi/credentials

# --- network ----------------------------------------------------------------
KROBI_BACKEND_PORT=8000

# --- authentication ---------------------------------------------------------
# Accounts are the normal way in: the first account created on a new server
# claims it (POST /api/claim -- the desktop app offers this when it connects)
# and becomes the owner, who then adds the rest of the household. Each device
# holds its own revocable token.
#
# Until the server is claimed, anyone who can reach the port can claim it.
# Set this to true to require the one-time setup code the server writes to its
# log and to $HOME/Krobi/setup-token:
# KROBI_REQUIRE_SETUP_TOKEN=false
#
# Legacy shared secret. Optional: any client presenting it is treated as the
# owner, and setting it removes the loopback exemption. If you use it, generate
# one and never reuse it anywhere else (openssl rand -hex 32). There is no TLS
# here: tokens cross the network in the clear, so keep this on the LAN or
# behind a VPN regardless.
KROBI_API_TOKEN=

# Escape hatch that restores the old wide-open behaviour for remote callers.
# Leave false. True means anyone who can reach port 8000 owns the library, and
# the app says so in the log on every start.
# KROBI_ALLOW_UNAUTHENTICATED_REMOTE=false

# /api/open-file, /api/set-basedir, /api/reset-basedir and /api/burn-audio-cd
# act on the machine running the backend, so they refuse remote callers even
# with a valid token. Set true only if you really do want to drive them from
# somewhere else.
# KROBI_ALLOW_REMOTE_LOCAL_ACTIONS=false

# Origins allowed to call the API from a browser. Comma-separated, no spaces.
# Keep the Tauri origins for packaged macOS/Linux and Windows webviews. `null`
# supports upgrades from an older desktop build.
# Add the dev machine's origin too if you run `npm run dev` against this box.
# Never use `*` -- the app sets allow_credentials=True and browsers reject a
# wildcard origin in that combination.
KROBI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost,null
# --- behaviour --------------------------------------------------------------
# Set from Ajustes → Configuración; uncommenting a key pins it read-only in the app.
# KROBI_LOG_LEVEL=INFO
# KROBI_MAX_CONCURRENT_DOWNLOADS=3
# KROBI_MAX_CONCURRENT_JOBS=2
# KROBI_ANALYSIS_WORKERS=2
# KROBI_ADVERTISE=true
# KROBI_LYRICS_ENGINE=auto
# Off by default. Needs an installed CPU engine and delegated cgroup v2;
# see docs/deployment.md, "Let the nest process when no helper is online".
# KROBI_NEST_PROCESSES=false
# KROBI_LYRICS_AUTO_FETCH=false
KROBI_EDITOR_RENDER_TIMEOUT=300
# KROBI_ENABLE_WAVEFORM_CACHE=true
# On-demand JPEG thumbnails live under the data dir's cache/covers, outside temp.
# Disk budget in MiB (positive integer); least recently used files are evicted.
# KROBI_COVER_CACHE_MB=200

# Opt-in. When true, background analysis rewrites BPM/key tags inside the
# user's own music files. Irreversible-ish; leave false unless asked for.
# KROBI_WRITE_ANALYSIS_TAGS=false

# --- ffmpeg -----------------------------------------------------------------
# Leave UNSET. app/config.py::resolve_ffmpeg() falls through to the static
# binary bundled in the imageio-ffmpeg wheel inside the venv. Only set this if
# you deliberately want the distro's ffmpeg (e.g. you need an encoder the
# bundled build lacks):
# KROBI_FFMPEG_PATH=/usr/bin/ffmpeg

# --- yt-dlp -----------------------------------------------------------------
# Pins yt-dlp's player client. Leave it unset -- pinning one client overrides
# yt-dlp's own maintained fallback chain, and a pin that worked once rots. If
# acquisition breaks, update yt-dlp first.
# KROBI_YTDLP_PLAYER_CLIENT=

# --cookies-from-browser is useless on a headless server: there is no browser
# profile to read. If the player-client bypass stops working, export
# cookies.txt from a desktop browser, copy it to the server, chown it to
# krobi, chmod 600, and point this at it. It contains live YouTube session
# cookies -- treat it as a password.
# KROBI_YTDLP_COOKIES_FILE=/var/lib/krobi/Krobi/credentials/cookies.txt

# --- optional API keys ------------------------------------------------------
# KROBI_GENIUS_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
#
# Spotify OAuth note: app/config.py builds the redirect URI as
# http://127.0.0.1:<KROBI_BACKEND_PORT>/api/spotify/callback. On a headless
# server that loopback callback cannot complete in a browser. Set
# SPOTIFY_REDIRECT_URI to a URL that actually resolves for the person doing
# the auth, and register the exact same string in the Spotify dashboard.
# SPOTIFY_REDIRECT_URI=http://192.0.2.10:8000/api/spotify/callback

# Forwarded headers are trusted only from loopback by default. Set a comma-separated
# list of actual reverse-proxy peer addresses when using another proxy. Never '*'.
FORWARDED_ALLOW_IPS=127.0.0.1

# Additional exact HTTP(S) download hosts, comma-separated. YouTube is built in.
# KROBI_DOWNLOADER_ALLOWED_HOSTS=media.example.org
